{
  "name": "ai-visibility-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:tokens && pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.0"
}
